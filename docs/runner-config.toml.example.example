concurrent = 10
check_interval = 0
connection_max_age = "15m0s"
shutdown_timeout = 0

[session_server]
  session_timeout = 1800

[[runners]]
  name = "gitlab-platform-runner-manager"
  url = "http://<gitlab-eip>"
  id = 2
  token = "<runner-registration-token>"
  token_obtained_at = 2026-01-01T00:00:00Z
  token_expires_at = 0001-01-01T00:00:00Z

  executor = "instance"
  request_concurrency = 2

  [runners.cache]
    MaxUploadedArchiveSize = 0

    [runners.cache.s3]
      AssumeRoleMaxConcurrency = 0

    [runners.cache.gcs]

    [runners.cache.azure]

  [runners.autoscaler]
    plugin = "aws"
    capacity_per_instance = 1
    max_use_count = 1
    max_instances = 10

    [runners.autoscaler.plugin_config]
      name = "<worker-asg-name>"
      region = "<aws-region>"

    [runners.autoscaler.connector_config]
      username = "ubuntu"
      use_external_addr = true

    [[runners.autoscaler.policy]]
      idle_count = 0
      idle_time = "10m0s"
      preemptive_mode = false
